[ext_resource type="Texture2D" uid="uid://bxgr4mg28j1u5" path="res://Sprites estatuas/Estatuadinosaurio.png" id="1_luqgl"]

[sub_resource type="GDScript" id="GDScript_r6hke"]
script/source = "extends Area2D

var ya_usado = false


func _ready() -> void:
	add_to_group(\"checkpoints\")
	body_entered.connect(_on_body_entered)


func _on_body_entered(body: Node2D) -> void:
	if ya_usado:
		return

	if body.name != \"Lyn Personaje\":
		return

	if not body.has_method(\"recibir_dano\"):
		return

	for checkpoint in get_tree().get_nodes_in_group(\"checkpoints\"):
		if checkpoint != self:
			checkpoint.desactivar_checkpoint()

	body.posicion_inicial = global_position + Vector2(0, -20)

	ya_usado = true
	monitoring = false
	monitorable = false


func desactivar_checkpoint() -> void:
	ya_usado = true
	monitoring = false
	monitorable = false
"

