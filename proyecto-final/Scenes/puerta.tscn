[sub_resource type="GDScript" id="GDScript_tswu4"]
script/source = "
extends Area2D

var lyn_actual = null
var puerta_abierta = false

@onready var bloqueo: CollisionShape2D = $StaticBody2D/CollisionShape2D
@onready var detector: Area2D = $Detector
@onready var animated_sprite: AnimatedSprite2D = $AnimatedSprite2D

@onready var fondo: Sprite2D = $fondo
@onready var label: Label = $Label
@onready var boton_e: Sprite2D = $BotonE
@onready var label2: Label = $Label2


func _ready() -> void:

	# La puerta comienza cerrada.
	animated_sprite.play(\"cerrado\")

	# Ocultar todos los mensajes al comenzar.
	fondo.hide()
	label.hide()
	boton_e.hide()
	label2.hide()

	# Detectar la entrada y salida de Lyn.
	detector.body_entered.connect(_on_body_entered)
	detector.body_exited.connect(_on_body_exited)


func _process(_delta: float) -> void:

	if lyn_actual == null or puerta_abierta:
		return

	# Si Lyn tiene la llave, puede abrir la puerta.
	if lyn_actual.tiene_llave:

		fondo.hide()
		label.hide()

		boton_e.show()
		label2.show()

		if Input.is_action_just_pressed(\"ui_e\"):
			abrir_puerta()

	else:

		# Si no tiene la llave, mostrar el aviso.
		fondo.show()
		label.show()

		boton_e.hide()
		label2.hide()


func _on_body_entered(body: Node2D) -> void:

	if body.name != \"Lyn Personaje\":
		return

	if puerta_abierta:
		return

	lyn_actual = body


func _on_body_exited(body: Node2D) -> void:

	if body == lyn_actual:

		lyn_actual = null

		fondo.hide()
		label.hide()
		boton_e.hide()
		label2.hide()


func abrir_puerta() -> void:

	if lyn_actual == null:
		return

	if not lyn_actual.tiene_llave:
		return

	puerta_abierta = true

	# Desactivar el bloqueo físico.
	bloqueo.set_deferred(\"disabled\", true)

	# Ocultar los mensajes.
	fondo.hide()
	label.hide()
	boton_e.hide()
	label2.hide()

	# Reproducir la animación de apertura.
	animated_sprite.play(\"abierto\")
"

