[sub_resource type="GDScript" id="GDScript_rqjai"]
script/source = "
extends Node2D

var lyn_actual: CharacterBody2D = null

var dialogo_activo = false
var indice_dialogo = 0
var dialogo_terminado = false

@onready var area: Area2D = $Area2D
@onready var fondo: Sprite2D = $CanvasLayer/Fondo

# Indicador para avanzar
@onready var avanza: Sprite2D = $CanvasLayer/Avanza/Sprite2D
@onready var label_avanza: Label = $CanvasLayer/Avanza/Label
@onready var label_avanza2: Label = $CanvasLayer/Avanza/Label2

# Sonido al avanzar el diálogo
@onready var sonido_saltar: AudioStreamPlayer = $CanvasLayer/Saltear

# Sprites de Protonus
@onready var proton1: Sprite2D = $CanvasLayer/Protonus/Proton1
@onready var proton2: Sprite2D = $CanvasLayer/Protonus/Proton2

@onready var textos: Array[Label] = [
	$CanvasLayer/Texto1,
	$CanvasLayer/Texto2,
	$CanvasLayer/Texto3,
	$CanvasLayer/Texto4,
	$CanvasLayer/Texto5
]

# Nombres que aparecen junto a cada texto.
@onready var nombres: Array[Label] = [
	$CanvasLayer/Nombre1,
	$CanvasLayer/Nombre2,
	$CanvasLayer/Nombre1,
	$CanvasLayer/Nombre2,
	$CanvasLayer/Nombre1
]

@onready var audios: Array[AudioStreamPlayer] = [
	$CanvasLayer/Audio1,
	$CanvasLayer/Audio2,
	$CanvasLayer/Audio3,
	$CanvasLayer/Audio4,
	$CanvasLayer/Audio5
]

@onready var reacciones: Array[Sprite2D] = [
	$CanvasLayer/ReaccionesLyn/Reaccion1,
	$CanvasLayer/ReaccionesLyn/Reaccion2,
	$CanvasLayer/ReaccionesLyn/Reaccion3
]

# 0 = Reaccion1
# 1 = Reaccion2
# 2 = Reaccion3
var reacciones_por_texto: Array[int] = [
	0, # Texto1
	2, # Texto2
	0, # Texto3
	2, # Texto4
	0  # Texto5
]

# 0 = Proton1
# 1 = Proton2
var proton_por_texto: Array[int] = [
	0, # Texto1 -> Proton1
	1, # Texto2 -> Proton2
	0, # Texto3 -> Proton1
	1, # Texto4 -> Proton2
	0  # Texto5 -> Proton1
]


func _ready() -> void:

	fondo.hide()

	for texto in textos:
		texto.hide()

	# Ocultar los nombres al iniciar.
	for nombre in get_nombres_unicos():
		nombre.hide()

	for reaccion in reacciones:
		reaccion.hide()

	proton1.hide()
	proton2.hide()

	# Ocultar indicador al iniciar.
	avanza.hide()
	label_avanza.hide()
	label_avanza2.hide()

	area.body_entered.connect(_on_body_entered)


# Devuelve los dos nodos de nombre sin repetirlos.
func get_nombres_unicos() -> Array[Label]:
	return [
		$CanvasLayer/Nombre1,
		$CanvasLayer/Nombre2
	]


func _on_body_entered(body: Node2D) -> void:

	if dialogo_terminado or dialogo_activo:
		return

	if body.name != \"Lyn Personaje\":
		return

	iniciar_dialogo(body)


func iniciar_dialogo(lyn: CharacterBody2D) -> void:

	lyn_actual = lyn

	dialogo_activo = true
	indice_dialogo = 0

	lyn_actual.bloqueada_por_dialogo = true

	detener_todos_los_audios()

	fondo.show()

	mostrar_dialogo()


func mostrar_dialogo() -> void:

	if indice_dialogo >= textos.size():
		finalizar_dialogo()
		return

	# Ocultar todos los textos.
	for texto in textos:
		texto.hide()

	# Ocultar todos los nombres.
	for nombre in get_nombres_unicos():
		nombre.hide()

	# Ocultar todas las reacciones.
	for reaccion in reacciones:
		reaccion.hide()

	# Ocultar los sprites de Protonus.
	proton1.hide()
	proton2.hide()

	detener_todos_los_audios()

	# Mostrar el texto correspondiente.
	textos[indice_dialogo].show()

	# Mostrar el nombre correspondiente.
	nombres[indice_dialogo].show()

	# Mostrar la reacción correspondiente.
	var indice_reaccion = reacciones_por_texto[indice_dialogo]
	reacciones[indice_reaccion].show()

	# Mostrar el sprite correspondiente de Protonus.
	var indice_proton = proton_por_texto[indice_dialogo]

	if indice_proton == 0:
		proton1.show()
	else:
		proton2.show()

	# Mostrar indicador Avanza.
	avanza.show()

	# Mostrar Label en todos los textos excepto el último.
	# En el último mostrar Label2.
	if indice_dialogo == textos.size() - 1:
		label_avanza.hide()
		label_avanza2.show()
	else:
		label_avanza.show()
		label_avanza2.hide()

	# Reproducir el audio correspondiente.
	if audios[indice_dialogo].stream != null:
		audios[indice_dialogo].play()


func detener_todos_los_audios() -> void:

	for audio in audios:
		audio.stop()


func _input(event: InputEvent) -> void:

	if not dialogo_activo:
		return

	if event.is_action_pressed(\"ui_e\") and not event.is_echo():

		# Reproducir sonido cada vez que se pulsa E.
		sonido_saltar.play()

		avanzar_dialogo()

		get_viewport().set_input_as_handled()


func avanzar_dialogo() -> void:

	indice_dialogo += 1

	if indice_dialogo >= textos.size():
		finalizar_dialogo()
		return

	mostrar_dialogo()


func finalizar_dialogo() -> void:

	dialogo_activo = false
	dialogo_terminado = true

	detener_todos_los_audios()

	fondo.hide()

	# Ocultar indicador Avanza.
	avanza.hide()
	label_avanza.hide()
	label_avanza2.hide()

	for texto in textos:
		texto.hide()

	for nombre in get_nombres_unicos():
		nombre.hide()

	for reaccion in reacciones:
		reaccion.hide()

	proton1.hide()
	proton2.hide()

	if lyn_actual != null:
		lyn_actual.bloqueada_por_dialogo = false

	area.set_deferred(\"monitoring\", false)
	area.set_deferred(\"monitorable\", false)
"

