[sub_resource type="GDScript" id="GDScript_o8cer"]
script/source = "
extends Node2D

const ID_DIALOGO = \"dialogo3\"

var lyn_actual: CharacterBody2D = null

var dialogo_activo = false
var indice_dialogo = 0
var dialogo_terminado = false

@onready var area: Area2D = $Area2D
@onready var fondo: Sprite2D = $CanvasLayer/Fondo

@onready var proton1: Sprite2D = $CanvasLayer/Protonus/Proton1
@onready var proton2: Sprite2D = $CanvasLayer/Protonus/Proton2

@onready var textos: Array[Label] = [
	$CanvasLayer/Texto1,
	$CanvasLayer/Texto2,
	$CanvasLayer/Texto3
]

@onready var nombres: Array[Label] = [
	$CanvasLayer/Nombre1,
	$CanvasLayer/Nombre2,
	$CanvasLayer/Nombre2
]

@onready var audios: Array[AudioStreamPlayer] = [
	$CanvasLayer/Audio1,
	$CanvasLayer/Audio2,
	$CanvasLayer/Audio3
]

@onready var sonido_saltear: AudioStreamPlayer = $CanvasLayer/Saltear

@onready var avanza: Sprite2D = $CanvasLayer/Avanza/Sprite2D
@onready var label_avanza: Label = $CanvasLayer/Avanza/Label
@onready var label_avanza2: Label = $CanvasLayer/Avanza/Label2

@onready var reacciones: Array[Sprite2D] = [
	$CanvasLayer/ReaccionesLyn/Reaccion1,
	$CanvasLayer/ReaccionesLyn/Reaccion2,
	$CanvasLayer/ReaccionesLyn/Reaccion3
]

var reacciones_por_texto: Array[int] = [
	1,
	2,
	2
]

var proton_por_texto: Array[int] = [
	0,
	1,
	1
]


func _ready() -> void:

	ocultar_todo()

	if GameState.dialogos_vistos.has(ID_DIALOGO):

		dialogo_terminado = true
		dialogo_activo = false

		area.set_deferred(\"monitoring\", false)
		area.set_deferred(\"monitorable\", false)

		return

	area.body_entered.connect(_on_body_entered)


func ocultar_todo() -> void:

	fondo.hide()

	for texto in textos:
		texto.hide()

	for nombre in get_nombres_unicos():
		nombre.hide()

	for reaccion in reacciones:
		reaccion.hide()

	proton1.hide()
	proton2.hide()

	avanza.hide()
	label_avanza.hide()
	label_avanza2.hide()

	detener_todos_los_audios()

	sonido_saltear.stop()


func get_nombres_unicos() -> Array[Label]:
	return [
		$CanvasLayer/Nombre1,
		$CanvasLayer/Nombre2
	]


func _on_body_entered(body: Node2D) -> void:

	if dialogo_terminado or dialogo_activo:
		return

	if GameState.dialogos_vistos.has(ID_DIALOGO):
		return

	if body.name != \"Lyn Personaje\":
		return

	iniciar_dialogo(body)


func iniciar_dialogo(lyn: CharacterBody2D) -> void:

	lyn_actual = lyn

	dialogo_activo = true
	indice_dialogo = 0

	lyn_actual.bloqueada_por_dialogo = true

	detener_todos_los_audios()

	fondo.show()

	mostrar_dialogo()


func mostrar_dialogo() -> void:

	if indice_dialogo >= textos.size():
		finalizar_dialogo()
		return

	for texto in textos:
		texto.hide()

	for nombre in get_nombres_unicos():
		nombre.hide()

	for reaccion in reacciones:
		reaccion.hide()

	proton1.hide()
	proton2.hide()

	detener_todos_los_audios()

	textos[indice_dialogo].show()

	nombres[indice_dialogo].show()

	var indice_reaccion = reacciones_por_texto[indice_dialogo]

	if indice_reaccion >= 0:
		reacciones[indice_reaccion].show()

	var indice_proton = proton_por_texto[indice_dialogo]

	if indice_proton == 0:
		proton1.show()
	else:
		proton2.show()

	avanza.show()

	if indice_dialogo == textos.size() - 1:
		label_avanza.hide()
		label_avanza2.show()
	else:
		label_avanza.show()
		label_avanza2.hide()

	if audios[indice_dialogo].stream != null:
		audios[indice_dialogo].play()


func detener_todos_los_audios() -> void:

	for audio in audios:
		audio.stop()


func _input(event: InputEvent) -> void:

	if not dialogo_activo:
		return

	if event.is_action_pressed(\"ui_e\") and not event.is_echo():

		if sonido_saltear.stream != null:
			sonido_saltear.play()

		avanzar_dialogo()

		get_viewport().set_input_as_handled()


func avanzar_dialogo() -> void:

	indice_dialogo += 1

	if indice_dialogo >= textos.size():
		finalizar_dialogo()
		return

	mostrar_dialogo()


func finalizar_dialogo() -> void:

	dialogo_activo = false
	dialogo_terminado = true

	detener_todos_los_audios()

	ocultar_todo()

	if lyn_actual != null:

		lyn_actual.bloqueada_por_dialogo = false


	if not GameState.dialogos_vistos.has(ID_DIALOGO):

		GameState.dialogos_vistos.append(ID_DIALOGO)

		var guardado = SaveManager.guardar_estado_actual()

		if not guardado:
			print(\"[Dialogo3] ERROR al guardar: \", SaveManager.ultimo_error)

	# Desactivar el área.
	area.set_deferred(\"monitoring\", false)
	area.set_deferred(\"monitorable\", false)
"

