[sub_resource type="GDScript" id="GDScript_q4r7r"]
script/source = "
extends Area2D

var recogida = false

func _ready() -> void:
	body_entered.connect(_on_body_entered)


func _on_body_entered(body: Node2D) -> void:
	if recogida:
		return

	if body.name != \"Lyn Personaje\":
		return

	recogida = true

	# Guardar la llave en Lyn.
	body.tiene_llave = true

	# Hacer desaparecer la llave.
	queue_free()
"

